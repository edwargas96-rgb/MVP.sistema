{
  "name": "mvp.sistema",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:lv": "npm run dev -w apps/lv-laboratorio",
    "dev:dlab": "npm run dev -w apps/dlab-digital",
    "dev:ultra": "npm run dev -w apps/ultra-dental",
    "build:lv": "npm run build -w apps/lv-laboratorio",
    "build:dlab": "npm run build -w apps/dlab-digital",
    "build:ultra": "npm run build -w apps/ultra-dental",
    "build:all": "npm run build -w apps/lv-laboratorio && npm run build -w apps/dlab-digital && npm run build -w apps/ultra-dental"
  }
}
